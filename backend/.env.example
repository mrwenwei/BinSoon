POSTGRES_USER=smart_bins
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=smart_bins
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Empty token disables bin creation, collection and simulation mutations. Set a private random token locally.
ADMIN_TOKEN=
SIMULATION_CAPACITY_LITERS=120
# Playback mapping for advance real_seconds: 1 real second = 600 simulated seconds.
SIMULATION_TIME_MULTIPLIER=600

# Enable only in a separate demo environment. Set private passwords (>=12 chars).
# Accounts/catalog are created explicitly with python -m scripts.seed_product_demo.
DEMO_AUTH_ENABLED=false
DEMO_CITIZEN_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_ADMIN_PASSWORD=
# JSON array; values are public origins, never credentials.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Compose overrides these to local + a persistent named volume.
MEDIA_BACKEND=local
MEDIA_DIRECTORY=/tmp/binsoon-media
# Cloud Run must use a private pre-provisioned bucket and IAM signing.
MEDIA_BUCKET=
MEDIA_SIGNING_SERVICE_ACCOUNT=

# Synthetic assumptions for new recycling compartments; existing states are not reset.
SIMULATION_RECYCLING_CAPACITY_LITERS=80
SIMULATION_RECYCLING_RATE_MULTIPLIER=0.65
