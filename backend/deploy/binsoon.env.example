# Non-secret deployment settings for the existing BinSoon project.
# From repository root: set -a; source backend/deploy/binsoon.env.example; set +a
GCP_PROJECT_ID=binsoon
REGION=asia-east1
CLOUD_SQL_INSTANCE=binsoon-db
CLOUD_SQL_CONNECTION_NAME=binsoon:asia-east1:binsoon-db
POSTGRES_USER=binsoon
POSTGRES_DB=binsoon
DB_PASSWORD_SECRET=binsoon-db-password
SECRET_VERSION=1
RUNTIME_SERVICE_ACCOUNT=binsoon-api@binsoon.iam.gserviceaccount.com
BUILD_SERVICE_ACCOUNT=binsoon-build@binsoon.iam.gserviceaccount.com
REPOSITORY=binsoon
SERVICE=binsoon-api
PUBLIC_ACCESS=true

# Existing Admin Secret Manager resource name (not the token value).
ADMIN_SECRET=binsoon-demo-admin-token
ADMIN_SECRET_VERSION=1

# A/B/D is opt-in; use a separate demo service/database, not real operations.
DEMO_AUTH_ENABLED=false
CORS_ORIGINS='[]'
# Private, pre-provisioned bucket. Empty means photo upload remains unavailable.
MEDIA_BUCKET=
MEDIA_SIGNING_SERVICE_ACCOUNT=binsoon-api@binsoon.iam.gserviceaccount.com
# Secret resource names only; required if DEMO_AUTH_ENABLED=true.
DEMO_CITIZEN_PASSWORD_SECRET=
DEMO_STAFF_PASSWORD_SECRET=
DEMO_ADMIN_PASSWORD_SECRET=
DEMO_CITIZEN_PASSWORD_SECRET_VERSION=latest
DEMO_STAFF_PASSWORD_SECRET_VERSION=latest
DEMO_ADMIN_PASSWORD_SECRET_VERSION=latest

# Synthetic assumptions for new recycling compartments; existing states are not reset.
SIMULATION_RECYCLING_CAPACITY_LITERS=80
SIMULATION_RECYCLING_RATE_MULTIPLIER=0.65
