# Non-secret deployment settings for the existing BinSoon project.
# From repository root: set -a; source backend/deploy/binsoon.env.example; set +a
GCP_PROJECT_ID=binsoon
REGION=asia-east1
CLOUD_SQL_INSTANCE=binsoon-db
CLOUD_SQL_CONNECTION_NAME=binsoon:asia-east1:binsoon-db
POSTGRES_USER=binsoon
POSTGRES_DB=binsoon
DB_PASSWORD_SECRET=binsoon-db-password
SECRET_VERSION=1
RUNTIME_SERVICE_ACCOUNT=binsoon-api@binsoon.iam.gserviceaccount.com
BUILD_SERVICE_ACCOUNT=binsoon-build@binsoon.iam.gserviceaccount.com
REPOSITORY=binsoon
SERVICE=binsoon-api
PUBLIC_ACCESS=true
