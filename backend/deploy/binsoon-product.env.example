# Non-secret settings for the deployed A/B/D demo (2026-10-19).
# From repo root: set -a; source backend/deploy/binsoon-product.env.example; set +a
GCP_PROJECT_ID=binsoon
REGION=asia-east1
CLOUD_SQL_INSTANCE=binsoon-db
CLOUD_SQL_CONNECTION_NAME=binsoon:asia-east1:binsoon-db
POSTGRES_USER=binsoon
POSTGRES_DB=binsoon
DB_PASSWORD_SECRET=binsoon-db-password
SECRET_VERSION=1
RUNTIME_SERVICE_ACCOUNT=binsoon-api@binsoon.iam.gserviceaccount.com
BUILD_SERVICE_ACCOUNT=binsoon-build@binsoon.iam.gserviceaccount.com
REPOSITORY=binsoon
SERVICE=binsoon-api
PUBLIC_ACCESS=true
ADMIN_SECRET=binsoon-demo-admin-token
ADMIN_SECRET_VERSION=1
DEMO_AUTH_ENABLED=true
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
MEDIA_BUCKET=binsoon-media-887203439341
MEDIA_SIGNING_SERVICE_ACCOUNT=binsoon-api@binsoon.iam.gserviceaccount.com
DEMO_CITIZEN_PASSWORD_SECRET=binsoon-demo-citizen-password
DEMO_STAFF_PASSWORD_SECRET=binsoon-demo-staff-password
DEMO_ADMIN_PASSWORD_SECRET=binsoon-demo-admin-password
DEMO_CITIZEN_PASSWORD_SECRET_VERSION=1
DEMO_STAFF_PASSWORD_SECRET_VERSION=1
DEMO_ADMIN_PASSWORD_SECRET_VERSION=1

# Synthetic assumptions for new recycling compartments; existing states are not reset.
SIMULATION_RECYCLING_CAPACITY_LITERS=80
SIMULATION_RECYCLING_RATE_MULTIPLIER=0.65
